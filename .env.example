# ===== Portafolio · Sukose — Variables de entorno =====
# Copia este archivo a `.env` y rellena los valores.
# (El archivo .env está en .gitignore y nunca se sube al repositorio.)

# --- Envío de correo desde el formulario de contacto ---
# Clave API de Resend. Consíguela en https://resend.com/api-keys
# Sin esta clave el endpoint POST /api/contacto responde 503.
RESEND_API_KEY=

# Email destino donde llegarán los mensajes del formulario.
CONTACTO_DESTINO=

# --- Servidor ---
# Puerto en el que escuchará Flask/gunicorn (default: 8000).
PORT=8000